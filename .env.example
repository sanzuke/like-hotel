APP_NAME="Like Hotel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database produksi: MySQL/MariaDB (sama dengan database lama likehotel_db)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=likehotel_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
MAIL_MAILER=log

# --- Like Hotel ---
ADMIN_WA=6282129248953
ADMIN_WA_DISPLAY="0821 2924 8953"
SITE_DOMAIN=likehotelsewa.com
COMMISSION_RATE=0.10
BOOKING_PENDING_EXPIRY_MINUTES=120

# --- Midtrans (JANGAN commit key asli) ---
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# --- Akun admin awal (dipakai `php artisan db:seed`; kosongkan PASSWORD untuk dibuatkan acak) ---
ADMIN_SEED_NAME="Admin Like Hotel"
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@likehotelsewa.com
ADMIN_SEED_PASSWORD=
